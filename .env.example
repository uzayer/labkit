# MongoDB credentials for docker-compose.yml. Generate a unique password before deployment.
MONGO_ROOT_PASSWORD=your-secure-password-here
MONGODB_URI=mongodb://admin:your-secure-password-here@mongo:27017/payloadcms?authSource=admin

# For a MongoDB process running directly on the host, use:
# MONGODB_URI=mongodb://127.0.0.1/payload-template-website

# The vercel blob token used for all media and backups (recommended).
# If not provided, payload will run in local file mode and will store files in /public folder and not in any file storage. This will only work for deployments with non-volatile storage and is not recommended.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_AAAAAAAAAAA_0000EXAMPLE000EXAMPLE000EXAMPLE000

# Used to encrypt JWT tokens. Required in production: use a unique, cryptographically random value of at least 32 characters. The demo value is for local development only.
PAYLOAD_SECRET="demo-payload-secret"

# Used to format links and URLs
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts. Use a unique, cryptographically random value of at least 32 characters in every environment; rotate it every 90 days. The demo value is for local development only.
NEXT_PRIVATE_DRAFT_SECRET=demo-draft-secret

# Used to revalidate static pages
REVALIDATION_KEY=demo-revalidation-key
NEXT_PRIVATE_REVALIDATION_KEY=demo-revalidation-key

# Turnstile CAPTCHA (REQUIRED for production form submissions).
# Create a site and get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key-here
NEXT_PRIVATE_TURNSTILE_SECRET_KEY=your-secret-key-here

# To support login with Google in the admin panel (optional)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Optional Gemini API key for LLM-assisted citation segmentation/field hints
GEMINI_API_KEY=

# Secret used to protect webhooks triggered by vercel cron jobs. Use a unique, cryptographically random value of at least 32 characters; never reuse it across environments. Will be automatically set by vercel.
CRON_SECRET="demo-cron-secret"

# Number of backups to keep. Change backup schedule in vercel.json file. Default is backup every day at 3am.
BACKUPS_TO_KEEP=4
