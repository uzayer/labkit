{
  "name": "labkit",
  "version": "0.0.1",
  "description": "LabKit — a PayloadCMS content platform for research lab websites, built with shadcn/ui.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun run generate:types && cross-env NODE_OPTIONS=--no-deprecation next build",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--no-deprecation bun run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:debug": "cross-env NODE_OPTIONS='--no-deprecation --inspect' next dev",
    "dev:prod": "rm -rf .next && bun run build && bun run start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "bun install",
    "tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation oxlint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation oxlint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "rm -rf node_modules bun.lock && bun install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "backup": "source .env && mongoexport -c pages --uri=$MONGODB_URI --out backup/pages.json --jsonArray",
    "backup:apply": "source .env && mongoimport -c pages --uri=$MONGODB_URI --file backup/pages.json --jsonArray --mode upsert",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@faker-js/faker": "^10.6.0",
    "@google/genai": "^2.23.0",
    "@hookform/resolvers": "^5.9.1",
    "@number-flow/react": "^0.6.2",
    "@payloadcms/admin-bar": "3.90.1",
    "@payloadcms/db-mongodb": "3.90.1",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/live-preview-react": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-form-builder": "3.90.1",
    "@payloadcms/plugin-nested-docs": "3.90.1",
    "@payloadcms/plugin-redirects": "3.90.1",
    "@payloadcms/plugin-search": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-vercel-blob": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "bson": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-region-data": "^4.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "input-otp": "^1.5.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "payload": "3.90.1",
    "payload-oauth2": "1.0.21",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-icons": "^5.7.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.13.1",
    "react-responsive-masonry": "^2.9.0",
    "react-turnstile": "^1.1.5",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
