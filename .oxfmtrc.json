{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": false,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/(frontend)/_template-pages/globals.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "**/payload-types.ts",
    ".tmp",
    "**/.git",
    "**/.hg",
    "**/.pnp.*",
    "**/.svn",
    "**/.yarn/**",
    "**/build",
    "**/dist/**",
    "**/node_modules",
    "**/temp",
    "**/docs/**",
    "labs/dial/scraped-data/**",
    ".agents/skills/**",
    "tsconfig.json",
    "dial-test/**",
    "next-env.d.ts"
  ]
}
